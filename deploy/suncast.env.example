INFLUX_URL=http://localhost:8086
INFLUX_ORG=home
# buspi stores Victron data in the shared bucket (vedirect-influx sink config)
VICTRON_BUCKET=buspi
VICTRON_MEASUREMENT=victron_mppt
PV_POWER_FIELD=pv_power
CHARGE_STATE_FIELD=charge_state
GEO_BUCKET=buspi
GEO_MEASUREMENT=geo
SUNCAST_PORT=8090
SUNCAST_DB=/var/lib/suncast/suncast.db
# skip a day's calibration if the van roamed >this many km (travel days)
DRIFT_KM_MAX=20
# primary forecast provider (open_meteo|forecast_solar); secondary shown for comparison
PROVIDER=open_meteo
PROVIDER_SECONDARY=forecast_solar

# --- optional; defaults shown (uncomment to override) ---
# InfluxDB bucket and measurement the forecast is mirrored to (Grafana)
# FORECAST_BUCKET=buspi
# FORECAST_MEASUREMENT=solar_forecast
# calibration window (days) and minimum samples before the factor is applied
# SUNCAST_WINDOW_DAYS=30
# SUNCAST_MIN_SAMPLES=5
# calibration factor clamp
# SUNCAST_CLAMP_LO=0.3
# SUNCAST_CLAMP_HI=1.3
# provider forecast cache lifetime (seconds)
# SUNCAST_CACHE_TTL_S=1800
